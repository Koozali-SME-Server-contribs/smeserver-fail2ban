msgstr "Esta é uma lista de hosts que não serão bloqueados pelo fail2ban."

msgid "f2b_VALIDFROM_TITLE"
msgstr "Hosts permitidos"

msgid "f2b_WHITELIST"
msgstr "Lista de permissões"

msgid "f2b_WORDPRESS"
msgstr "wordpress"

msgid "f2b_WORDPRESS_STATUS"
msgstr "Status das jails do WordPress. Você precisa ativá-las manualmente, quer as tenha em um ibay quer use o contrib. Instale também o plugin em todas as suas instâncias do WordPress."

msgid "f2b_recidive_BANTIME"
msgstr "Defina o tempo de bloqueio padrão para a jail de reincidência (o valor inicial padrão é 604800 segundos)."

msgid "f2b_recidive_FINDTIME"
msgstr "Defina o tempo de busca padrão para a jail de reincidência (o valor inicial padrão é 86400 segundos)."

msgid "f2b_recidive_MAXRETRY"
msgstr "Defina o número máximo padrão de tentativas permitidas antes do bloqueio pela jail de reincidência (o valor inicial padrão é 5)."
