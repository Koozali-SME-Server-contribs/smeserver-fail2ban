msgstr "Para adicionar uma nova rede permitida, digite os detalhes abaixo."

msgid "f2b_EJABBERD"
msgstr "ejabberd"

msgid "f2b_EJABBERD_STATUS"
msgstr "Status da jail ejabberd, se instalada. Nada é executado se o ejabberd não estiver instalado ou desativado."

msgid "f2b_EMAIL"
msgstr "E-mail de alerta"

msgid "f2b_ERROR_STOPPING"
msgstr "Erro ao tentar parar o serviço"

