msgid "f2b_SMANAGER"
msgstr "Smanager"

msgid "f2b_SMANAGER_STATUS"
msgstr "Status das jails do smanager. Você precisa ativá-las manualmente se as instalar depois do fail2ban."

msgid "f2b_SOGOD"
msgstr "SOGO"

