msgstr "Não é possível desbloquear"

msgid "f2b_ERROR_UPDATING_WHITE"
msgstr "Não é possível desbloquear nem adicionar à lista de permissões"

msgid "f2b_ERR_EXISTS"
msgstr "Erro: o IP já está na lista de permissões"

msgid "f2b_ERR_INVALID_PARAMS"
msgstr "Parâmetros de rede inválidos"

